APP_NAME=examate-rag
ENVIRONMENT=local

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Model provider (OpenAI-compatible chat-completions and embeddings endpoints)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
FALLBACK_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2

CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# Optional: set these to get estimated_cost_usd instead of null.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=
EMBEDDING_COST_PER_1M=
